# Hosted Gemini interprets questions. Calculations and evidence stay in typed tools.
# Keep actual credentials in ignored .env.local, never in browser variables.
GEMINI_API_KEY=
# Optional comma-separated keys, only from independently authorized projects.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REASONING_MODEL=gemini-3.8-flash
# Conservative local scheduling setting; check each project's actual AI Studio quota.
GEMINI_RPM=5
GEMINI_TPM=20000
GEMINI_RPD=100
REFERENCE_DATE=2026-10-16
PORT=4178
# Path to the FlytBase dataset (clone it next to this repo). For the 600-well test set use .../test-data/dataset and REFERENCE_DATE=2027-01-15.
SAMPLE_DATA_PATH=../../flytbase-ahc-swe-asset-intelligence-dataset/sample-data
